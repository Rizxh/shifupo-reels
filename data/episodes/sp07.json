  "claims": [
    { "text": "Tahun Kambing Api (丁未) dimulai pada Imlek 6 Februari 2027", "reviewed": true },
    { "text": "Babi dan Kelinci satu kelompok San He (亥卯未) dengan Kambing", "reviewed": false },
    { "text": "Kuda pasangan Liu He (午未) bagi Kambing", "reviewed": false },
    { "text": "Macan, Naga, Ular, Monyet dan Ayam tidak punya hubungan khusus dengan Kambing, sehingga disebut cenderung stabil", "reviewed": false },
    { "text": "Kambing berada di tahun shionya sendiri (Ben Ming Nian), saran umum: jaga kesehatan dan tidak gegabah", "reviewed": false },
    { "text": "Kerbau bentrok (Chong 丑未), Anjing (Xing/Po 戌未) dan Tikus (Hai 子未) disarankan lebih teliti", "reviewed": false }
  ],
